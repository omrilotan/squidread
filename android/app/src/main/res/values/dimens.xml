<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
  <!--
    Page margins above and below the text. Applied by the app around the reader rather than by
    Readium (whose own padding, zeroed below, did not show on some e-ink devices).
  -->
  <dimen name="reader_padding_top">24dp</dimen>
  <dimen name="reader_padding_bottom">20dp</dimen>
  <!-- Overrides Readium's own value, so it is used, just not by the app's code. -->
  <dimen name="readium_navigator_epub_vertical_padding" tools:ignore="UnusedResources">0dp</dimen>
</resources>
