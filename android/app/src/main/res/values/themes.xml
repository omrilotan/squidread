<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- E-ink: pure black and white (swapped in the dark theme), no animations, no ripples, no shadows. -->
  <style name="Theme.Squidread" parent="Theme.AppCompat.DayNight.NoActionBar">
    <item name="android:windowBackground">@color/paper</item>
    <item name="android:windowAnimationStyle">@null</item>
    <item name="android:windowActivityTransitions">false</item>
    <item name="android:statusBarColor">@color/paper</item>
    <item name="android:navigationBarColor">@color/paper</item>
    <item name="android:textColor">@color/ink</item>
    <item name="android:textColorPrimary">@color/ink</item>
    <item name="android:textColorSecondary">@color/ink</item>
    <item name="colorPrimary">@color/ink</item>
    <item name="colorAccent">@color/ink</item>
    <item name="colorControlNormal">@color/ink</item>
    <item name="colorControlHighlight">@android:color/transparent</item>
    <item name="alertDialogTheme">@style/Theme.Squidread.Dialog</item>
  </style>

  <style name="Theme.Squidread.Dialog" parent="Theme.AppCompat.DayNight.Dialog.Alert">
    <item name="android:windowAnimationStyle">@null</item>
    <item name="android:windowBackground">@drawable/dialog_background</item>
    <item name="android:backgroundDimEnabled">false</item>
    <item name="android:windowElevation">0dp</item>
    <item name="colorAccent">@color/ink</item>
    <item name="colorControlHighlight">@android:color/transparent</item>
    <item name="android:textColorPrimary">@color/ink</item>
    <item name="android:textColorSecondary">@color/ink</item>
  </style>

  <style name="Squidread.Button" parent="">
    <item name="android:background">@drawable/button</item>
    <item name="android:textColor">@color/button_text</item>
    <item name="android:gravity">center</item>
    <item name="android:minHeight">48dp</item>
    <item name="android:paddingStart">12dp</item>
    <item name="android:paddingEnd">12dp</item>
    <item name="android:textSize">16sp</item>
    <item name="android:clickable">true</item>
    <item name="android:focusable">true</item>
  </style>

  <!-- Menu tabs share one row: shrink the label to fit rather than break it across lines,
       as happens with large display or font sizes. -->
  <style name="Squidread.Tab" parent="Squidread.Button">
    <item name="android:paddingStart">4dp</item>
    <item name="android:paddingEnd">4dp</item>
    <item name="android:maxLines">1</item>
    <item name="autoSizeTextType">uniform</item>
    <item name="autoSizeMinTextSize">10sp</item>
    <item name="autoSizeMaxTextSize">16sp</item>
  </style>
  <style name="Squidread.Tab.Icon">
    <item name="android:tint">@color/button_text</item>
    <item name="android:scaleType">center</item>
    <item name="android:paddingTop">8dp</item>
    <item name="android:paddingBottom">8dp</item>
  </style>

  <style name="Squidread.Heading" parent="">
    <item name="android:textSize">18sp</item>
    <item name="android:textStyle">bold</item>
    <item name="android:textColor">@color/ink</item>
    <item name="android:paddingTop">16dp</item>
    <item name="android:paddingBottom">8dp</item>
  </style>

  <!-- For the reading settings below the preview, which should leave the book as much room as they can. -->
  <!-- An icon and its value over a stepper's buttons; the value is underlined, as tapping it resets. -->
  <style name="Squidread.StepperValue" parent="">
    <item name="android:textSize">15sp</item>
    <item name="android:textColor">@color/ink</item>
    <item name="android:drawableTint">@color/ink</item>
    <item name="android:drawablePadding">6dp</item>
    <item name="android:gravity">center</item>
    <item name="android:maxLines">1</item>
    <item name="android:minHeight">40dp</item>
    <item name="android:paddingTop">4dp</item>
    <item name="android:paddingStart">4dp</item>
    <item name="android:paddingEnd">4dp</item>
    <item name="android:clickable">true</item>
    <item name="android:focusable">true</item>
  </style>
  <!-- An icon over a small label, as in the Justify buttons. -->
  <style name="Squidread.Button.IconLabel">
    <item name="android:drawableTint">@color/button_text</item>
    <item name="android:drawablePadding">2dp</item>
    <item name="android:textSize">12sp</item>
    <!-- One line; a long label shrinks to fit with large system text. -->
    <item name="android:maxLines">1</item>
    <item name="autoSizeTextType">uniform</item>
    <item name="autoSizeMinTextSize">9sp</item>
    <item name="autoSizeMaxTextSize">12sp</item>
    <item name="android:paddingTop">6dp</item>
    <item name="android:paddingBottom">4dp</item>
    <item name="android:paddingStart">4dp</item>
    <item name="android:paddingEnd">4dp</item>
  </style>
</resources>
