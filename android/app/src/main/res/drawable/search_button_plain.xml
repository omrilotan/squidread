<?xml version="1.0" encoding="utf-8"?>
<!-- A borderless button inside a search box; pressed inverts. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:state_pressed="true">
    <shape><solid android:color="@color/ink" /></shape>
  </item>
  <item>
    <shape><solid android:color="@color/paper" /></shape>
  </item>
</selector>
