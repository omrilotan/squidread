<?xml version="1.0" encoding="utf-8"?>
<!-- Selected and pressed states invert: readable without greys on e-ink. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:state_enabled="false">
    <shape>
      <solid android:color="@color/paper" />
      <stroke android:width="1dp" android:color="@color/ink" android:dashWidth="4dp" android:dashGap="4dp" />
    </shape>
  </item>
  <item android:state_selected="true">
    <shape>
      <solid android:color="@color/ink" />
    </shape>
  </item>
  <item android:state_pressed="true">
    <shape>
      <solid android:color="@color/ink" />
    </shape>
  </item>
  <item>
    <shape>
      <solid android:color="@color/paper" />
      <stroke android:width="2dp" android:color="@color/ink" />
    </shape>
  </item>
</selector>
