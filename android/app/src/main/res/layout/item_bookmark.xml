<?xml version="1.0" encoding="utf-8"?>
<!-- A bookmark: its chapter and words, which open it, and a button that removes it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="horizontal">

  <LinearLayout
    android:id="@+id/bookmark_open"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:background="@drawable/toc_item"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="48dp"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="8dp"
    android:paddingBottom="10dp">

    <TextView
      android:id="@+id/bookmark_chapter"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:duplicateParentState="true"
      android:ellipsize="end"
      android:maxLines="1"
      android:paddingBottom="2dp"
      android:textAlignment="viewStart"
      android:textColor="@color/button_text"
      android:textDirection="firstStrong"
      android:textSize="13sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/bookmark_text"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:duplicateParentState="true"
      android:ellipsize="end"
      android:maxLines="2"
      android:textAlignment="viewStart"
      android:textColor="@color/button_text"
      android:textDirection="firstStrong"
      android:textSize="16sp" />
  </LinearLayout>

  <TextView
    android:id="@+id/bookmark_remove"
    style="@style/Squidread.Button"
    android:layout_width="52dp"
    android:layout_height="match_parent"
    android:background="@drawable/toc_item"
    android:contentDescription="@string/bookmark_remove"
    android:paddingStart="0dp"
    android:paddingEnd="0dp"
    android:text="@string/close_symbol" />
</LinearLayout>
